			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1695718062914</Id>
					<Name><![CDATA[onMessageReceived]]></Name>
					<X>200</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[Map<String,? extends Object>]]></Type>
					</Parameter>
					<Body><![CDATA[if (communicator != null) {
	communicator.send(message);
} else{
	System.out.println("Communicator not yet initialized");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1696236513656</Id>
					<Name><![CDATA[onMessageFromBridge]]></Name>
					<X>200</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[Map<String, ? extends Object>]]></Type>
					</Parameter>
					<Body><![CDATA[if (message.get("id") instanceof String) {
	int id = Integer.parseInt((String) message.get("id"));
	StreamSupport.stream(getEngine().getRoot().agents().spliterator(), false)
		.filter(a -> a.getId() == id)
		.findFirst()
		.ifPresentOrElse(
			a -> agentLink.send(message, a), 
			() -> System.out.println("Agent with id " + id + " not found")
		);
} else if (message.get("type") instanceof String) {
	String type = (String) message.get("type");
	StreamSupport.stream(getEngine().getRoot().agents().spliterator(), false)
		.filter(a -> a.getClass().getSimpleName().equals(type))
		.forEach(a -> agentLink.send(message, a));
	connections.send(message, main);
	//System.out.println("The message just received says: " + message);
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1696326665715</Id>
