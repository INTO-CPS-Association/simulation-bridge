		<ActiveObjectClass>
			<Id>1695634886650</Id>
			<Name><![CDATA[BridgeConnection]]></Name>
			<Import><![CDATA[import al.com.communicators.UDPCommunicator;
import al.com.parsers.JsonParser;
import al.com.communicators.Communicator;
import al.com.communicators.UDPCommunicator;
import java.net.SocketException;
import java.net.UnknownHostException;
import java.lang.reflect.Method;
import java.lang.reflect.InvocationTargetException;
import java.util.stream.StreamSupport;]]></Import>
			<StartupCode><![CDATA[try {
	this.communicator = new UDPCommunicator(ip, localPort, remotePort);
	this.communicator.setParser(new JsonParser());
	this.communicator.addListener(this::onMessageFromBridge, Map.of());
}
catch (UnknownHostException e){
	error(e, "Unknown host: "+ip);
}
catch (SocketException e) {
	error(e, "Socket error");
}]]></StartupCode>
