			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1753697907067</Id>
					<Name><![CDATA[triggerConveyor]]></Name>
					<X>400</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[Map<String, ? extends Object>]]></Type>
					</Parameter>
					<Body><![CDATA[Map<String, Object> data = (Map<String, Object>) message.get("data");
String state = (String) data.get("state");
String variable = (String) data.get("variable");
//if (variable.equals("conveyorTargetState")) {	
conveyorTargetState = state;
if (state.equals("not active")){
	conveyor.stop();	
}
else if (state.equals("active")){
	conveyor.run();
}
//}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1756371560251</Id>
					<Name><![CDATA[triggerConveyor1]]></Name>
					<X>400</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[Map<String, ? extends Object>]]></Type>
					</Parameter>
					<Body><![CDATA[Map<String, Object> data = (Map<String, Object>) message.get("data");
String state = (String) data.get("state");
String variable = (String) data.get("variable");
//if (variable.equals("conveyorTargetState")) {	
conveyor1TargetState = state;
if (state.equals("not active")){
	conveyor1.stop();	
}
else if (state.equals("active")){
	conveyor1.run();
}
//}]]></Body>
				</Function>
