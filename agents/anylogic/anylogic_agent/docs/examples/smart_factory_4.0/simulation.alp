			<AgentLinks>
				<AgentLink>
					<Id>1695634419557</Id>
					<Name><![CDATA[connections]]></Name>
					<X>50</X><Y>-50</Y>
					<Label><X>15</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<OnReceive><![CDATA[System.out.println("This is for main from " + sender + "; the message is: " + msg);
Map<String, Object> data = (Map<String, Object>) msg.get("data");
String variable = (String) data.get("variable");
if (variable.equals("conveyorTargetState")) {
	this.triggerConveyor(msg);
}
else if (variable.equals("conveyor1TargetState")) {
	this.triggerConveyor1(msg);
}
else if (variable.equals("conveyor2TargetState")) {
	this.triggerConveyor2(msg);
}
else if (variable.equals("conveyor3TargetState")) {
	this.triggerConveyor3(msg);
}
else if (variable.equals("executionTime")) {
	String velocity = (String) data.get("state");
	if (velocity.equals("low")) {
		this.executionTime = 6;
	}
	else if (velocity.equals("medium")) {
		this.executionTime = 4;
	}
	else if (velocity.equals("high")) {
		this.executionTime = 2;
	}
}]]></OnReceive>
					<HandleReceiveInConnections>false</HandleReceiveInConnections>
