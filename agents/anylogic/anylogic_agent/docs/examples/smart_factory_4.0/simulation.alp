					</Parameter>
					<Body><![CDATA[Map<String, Object> data = (Map<String, Object>) message.get("data");
String state = (String) data.get("state");
String variable = (String) data.get("variable");
//if (variable.equals("conveyorTargetState")) {	
conveyorTargetState = state;
if (state.equals("not active")){
	conveyor.stop();	
}
else if (state.equals("active")){
	conveyor.run();
}
//}]]></Body>
